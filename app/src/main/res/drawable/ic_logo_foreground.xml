<?xml version="1.0" encoding="utf-8"?>
<!-- Zenith logo: speedometer arc with the needle in the red zone. 108dp adaptive canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Drawing spans x 27.25–80.75, y 27.25–68.75 (center 54, 48). Scaled to 0.86 around that center
         and moved down 3: the dial's hub sits just under the middle (57), where the eye expects the
         center of a gauge open at the bottom; moved down 7 it looked low in every mask. -->
    <group
        android:pivotX="54"
        android:pivotY="48"
        android:scaleX="0.86"
        android:scaleY="0.86"
        android:translateY="3">
        <path
            android:pathData="M33.22,66 A24,24 0 1,1 74.78,66"
            android:strokeWidth="5.5"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
            android:pathData="M66,33.22 A24,24 0 0,1 74.78,66"
            android:strokeWidth="5.5"
            android:strokeColor="#FF3B30"
            android:strokeLineCap="round" />
        <path
            android:pathData="M54,54 L62.5,40.9"
            android:strokeWidth="5"
            android:strokeColor="#FF3B30"
            android:strokeLineCap="round" />
        <path
            android:pathData="M49.5,54 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
